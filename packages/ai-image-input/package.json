{
  "name": "@ai-wc/ai-image-input",
  "version": "0.1.0",
  "main": "dist/ai-image-input.es.js",
  "module": "dist/ai-image-input.es.js",
  "types": "dist/src/ai-image-input.d.ts",
  "scripts": {
    "build": "wireit",
    "lint": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "src/**/*",
        "vite.config.ts"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "src/**/*"
      ]
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.1.3"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "wireit": "^0.14.12"
  }
}
