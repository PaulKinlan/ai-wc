{
  "name": "@ai-wc/ai-image-input",
  "version": "0.1.0",
  "main": "dist/ai-image-input.es.js",
  "module": "dist/ai-image-input.es.js",
  "types": "dist/src/ai-image-input.d.ts",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "lint": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "src/**/*",
        "vite.config.ts"
      ]
    },
    "lint": {
      "command": "eslint .",
      "files": [
        "src/**/*"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "vite": "^5.4.21",
    "wireit": "^0.14.12"
  }
}
